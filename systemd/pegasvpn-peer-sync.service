[Unit]
Description=PegasVPN WireGuard entitlement reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/onetapvpn-api
EnvironmentFile=/etc/onetapvpn/pegasvpn.env
Environment=PEGASVPN_DEPLOYMENT=production
# Access policy is inherited from the same env file as the API.
# Do NOT force Apple-only access before StoreKit subscriptions are live.
ExecStart=/opt/onetapvpn-api/.venv/bin/python /opt/onetapvpn-api/sync_peers.py
TimeoutStartSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# wg and wg0.conf updates require host network and /etc/wireguard access.
